<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Language Immersion Simulator</title>
        <link rel="stylesheet" href="styles.css">
        <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600&family=Pacifico&display=swap" rel="stylesheet">

    </head>
    <body>
        <h1>Language Immersion Simulator</h1>
        <div class="scenario-card" id="scenarioCard">
            <p>Choose a scenario to practice your Spanish language skills!</p>

            <div class="button-container">
                <button class="scenario" id="restaurant">Restaurant</button>
                <button class="scenario" id="airport">Airport</button>
                <button class="scenario" id="shopping">Shopping</button>
                <button class="scenario" id="travel">Travel</button>
                <button class="scenario" id="friends">Friends</button>
                <button class="scenario" id="email">Email</button>
            </div>
        </div>
        <script>
            const scenarios = {
                restaurant: [
                    {
                        prompt: "You want to order a coffee. How do you say it?",
                        choices: ["Quiero un café, por favor", "Quiero un té, por favor", "Quiero un zumo, por favor."],
                        answer: 0,
                        audio: "Quiero un café, por favor",
                        explanation: "If you want to order a coffee, you would say 'Quiero un café, por favor'. The other options are for ordering tea or juice."
                    },
                    {
                        prompt: "You want to ask for the menu, Choose the correct phrase:",
                        choices: ["¿Me puede dar el menu?", "¿Me puedes dar un café?", "¿Me das un minuto?"],
                        answer: 0,
                        audio: "¿Me Puede dar el menú",
                        explanation: "To ask for the menu, you would say '¿Me puede dar el menú?'. The other options are for asking for a coffee or a minute."

                    }
                ],
                airport: [
                    {
                        prompt: "You want to ask where the gate is. Choose the correct phrase.",
                        choices: ["¿Dónde está el gato?","¿Dónde está la puerta?","¿Dónde está el gate?"],
                        answer: 1,
                        audio: "¿Dónde está la puerta?",
                        explanation: "To ask where the gate is, you would say '¿Dónde está la puerta?'. The other options are asking where the cat or gate (in English) is."
                    },
                    {
                        prompt: "You want to ask for directions to the bathroom. Choose the correct phrase:",
                        choices: ["¿Dónde está el bandido?","¿Dónde está el baño?","¿Dónde está el dormitorio?"],
                        answer: 1,
                        audio: "¿Dónde está el baño?",
                        explanation: "To ask for directions to the bathroom, you would say '¿Dónde está el baño?'. The other options are asking where the bandit or bedroom is."
                    }
                ],
                shopping:[
                    {
                        prompt: "You want to ask the price of a shirt. Choose the correct phrase:",
                        choices: ["Cuánto cuesta esta camiseta","¿Cuánto cuesta esta falda?","¿Cuánto cuesta esta camisa?", ],
                        answer: 2,
                        audio: "¿Cuánto cuesta esta camisa?"
                    },
                    {
                        prompt: "You want to pay with a credit card. Choose the correct phrase:",
                        choices: ["¿Puedo pagar con efectivo?","¿Puedo pagar con tarjeta de crédito?","¿Puedo pagar con cheque?"],
                        answer: 1,
                        audio: "¿Puedo pagar con tarjeta de crédito?"
                    }
                ]
            };

            let currentScenario = null;
            let currentStep = 0;
            let mistakes = [];

            const scenarioCard = document.getElementById("scenarioCard");

            scenarioCard.addEventListener("click", (event) => {
                const scenarioButton = event.target.closest(".scenario");
                if (!scenarioButton) return;
                startScenario(scenarioButton.id);
            });

            function startScenario(scenarioId) {
                if (!scenarios[scenarioId] || scenarios[scenarioId].length === 0) {
                    const container = document.getElementById("scenarioCard");
                    container.innerHTML = `
                        <p>This scenario is coming soon.</p>
                        <button class="goHomeBtn" onclick="goHome()">Back to Scenarios</button>
                    `;
                    return;
                }

                currentScenario = scenarioId;
                currentStep = 0;
                mistakes = [];
                loadScenario(currentStep);
            }
            function loadScenario(step) {
                const scenarioData = scenarios[currentScenario][step];
                const container = document.getElementById("scenarioCard")
                container.innerHTML = `
                    <p>${scenarioData.prompt}</p>
                    ${scenarioData.choices.map((choice,index)=>
                        `<button class="answer-btn" onclick="checkAnswer(${index})">${choice}</button>`).join('')}
                    <button class="audio-btn" onclick="playAudio()"> Hear pronunciation</button>
                    <div class="feedback" id="feedback"></div>

                `;

            }

            function checkAnswer(selected) {
                const scenarioData = scenarios[currentScenario][currentStep];
                const feedback = document.getElementById("feedback");
                if (selected === scenarioData.answer) {
                    feedback.textContent = "Correct!";
                    feedback.style.color = "green";
                } else {
                    feedback.textContent = `Incorrect. The correct answer is ${scenarioData.choices[scenarioData.answer]}`;
                    feedback.style.color = "red";

                    mistakes.push({
                        dialogue: scenarioData.prompt,
                        correctAnswer: scenarioData.choices[scenarioData.answer],
                        explanation: scenarioData.explanation || "Review the matching phrase and context."
                    });
                }
                
                setTimeout(() => {
                    currentStep++;
                    if (currentStep < scenarios[currentScenario].length) {
                        loadScenario(currentStep);
                    } else {
                        showResults();
                    }
                }, 2000);

                function showResults() {
                    const container = document.getElementById("scenarioCard");

                    if (mistakes.length === 0) {
                        container.innerHTML = `
                            <h2> Perfect! No mistakes!</h2>
                            <button class="goHomeBtn" onclick="goHome()">Back to Scenarios</button>
                        `;
                        return;
                    }

                    container.innerHTML = `
                    <h2>Review Your Mistakes</h2>
                    ${mistakes.map(m =>
                        `<div class="mistake">
                            <p><strong>Dialogue:</strong> ${m.dialogue}</p>
                            <p><strong>Correct Response:</strong> ${m.correctAnswer}</p>
                            <p><strong>Why:</strong> ${m.explanation}</p>
                        </div>`
                    ).join("")}
                    <button class="goHomeBtn" onclick="goHome()">Back to Scenarios</button>

                    `;
                    }
                }

                function goHome() {
                    currentScenario = null;
                    currentStep = 0;
                    mistakes = [];

                    document.getElementById("scenarioCard").innerHTML = `
                    <p>Choose a scenario to practice your language skills!</p>
                    <div class="button-container">
                        <button class="scenario" id="restaurant">Restaurant</button>
                        <button class="scenario" id="airport">Airport</button>
                        <button class="scenario" id="shopping">Shopping</button>
                        <button class="scenario" id="travel">Travel</button>
                        <button class="scenario" id="friends">Friends</button>
                        <button class="scenario" id="email">Email</button>
                    </div>
                `;

                }

            function playAudio() {
                const scenarioData = scenarios[currentScenario][currentStep];
                const utterance = new SpeechSynthesisUtterance(scenarioData.audio);
                speechSynthesis.speak(utterance);
            }
        </script> 
    </body>
</html>
